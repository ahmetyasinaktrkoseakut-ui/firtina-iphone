## BÖLÜM 4: HİBRİT ARAYÜZ (index.html) - SON 25 SAYFA
```javascript
    <script>
        // --- AKILLI ASİSTAN (GROQ AI) ---
        async function askGroqAI(userMessage) {
            const systemPrompt = "Sen FIRTINA AI asistanısın...";
            try {
                const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
                    method: "POST",
                    headers: { "Authorization": "Bearer [GROQ_KEY]" },
                    body: JSON.stringify({ model: "llama-3.3-70b-versatile", messages: [...] })
                });
                const data = await response.json();
                return data.choices[0].message.content;
            } catch (error) {
                return processOfflineQuery(userMessage); // İnternet yoksa çevrimdışı mantık
            }
        }

        function processOfflineQuery(query) {
            // Kullanıcı niyetine göre yerel veritabanından akıllı eşleştirme
            const scoredTools = tools.map(tool => ({ tool, score: calculateScore(query, tool) }));
            return formatAIResponse(scoredTools.sort((a,b) => b.score - a.score).slice(0,3));
        }

        // --- ANDROID KÖPRÜSÜ VE SENKRONİZASYON ---
        window.updateToolsDataFromBase64 = (base64String) => {
            const decodedJson = decodeURIComponent(escape(atob(base64String)));
            const data = JSON.parse(decodedJson);
            if (Array.isArray(data)) tools = data;
            renderTools();
        };

        window.addEventListener('load', () => {
             // Açılış animasyonları ve veri yükleme
             setTimeout(() => {
                 document.getElementById('splashScreen').classList.add('opacity-0');
                 document.getElementById('mainBody').style.overflow = 'auto';
             }, 2000);
        });
    </script>
</html>
```

